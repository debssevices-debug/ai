# ─────────────────────────────────────────────────────────────────────────────
# NEC AI — configuration. Copy this file to .env and fill in what you need.
# Never commit .env: it holds your keys (.gitignore already excludes it).
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
# gemini (default) | claude | openai | ollama (local model on this PC: free, NO API key)
LLM_PROVIDER=gemini
# Empty = provider default (gemini-flash-latest / claude-opus-5 / gpt-4.1-mini / qwen3:8b)
LLM_MODEL=
GOOGLE_API_KEY=
# Claude: key from https://console.anthropic.com (starts with sk-ant-)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (OpenRouter, local server...)
OPENAI_BASE_URL=
# Ollama only: where it runs, and the context window (lower it if RAM is short)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
# Seconds per model answer (default 60, and 300 for ollama when left unset)
# LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
# Longest wait accepted before retrying (quota reset). Beyond it, give up.
LLM_MAX_RETRY_WAIT=60
# Client-side pacing, in requests per minute (0 = no limit).
# Gemini FREE tier allows only ~5 requests/minute: keep 5 unless billing is on.
# Each agent step is one request, so a research task uses 4-10 requests.
LLM_REQUESTS_PER_MINUTE=5

# ── Agent ────────────────────────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=20
# At this step the agent is told to answer if it is no longer making progress (0 = off)
AGENT_CHECKPOINT_STEP=7
TOOL_TIMEOUT=60

# ── Web search ───────────────────────────────────────────────────────────────
# duckduckgo (free, no key) | brave | serper (Google results)
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=6
SEARCH_REGION=fr-fr

# ── Voice (LiveKit, see README) ──────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STT_API_KEY=
TTS_API_KEY=

# ── API server / client ──────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated bearer tokens accepted by the API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
RATE_LIMIT_PER_MINUTE=30
SERVER_URL=http://127.0.0.1:8000

# ── Logs ─────────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
TRACE_ENABLED=true

# ── Browser (Playwright) — every setting has a safe default ──────────────────
# NEC_BROWSER_ENABLED=true
# NEC_BROWSER_HEADLESS=true
# NEC_BROWSER_CHANNEL=msedge
# NEC_BROWSER_ALLOWED_HOSTS=
# NEC_BROWSER_BLOCKED_HOSTS=
