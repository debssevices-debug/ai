# ─────────────────────────────────────────────────────────────────────────────
# NEC AI — configuration. Copy this file to .env and fill in what you need.
# Never commit .env: it holds your keys (.gitignore already excludes it).
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
# gemini (default) or openai
LLM_PROVIDER=gemini
# Empty = provider default (gemini-flash-latest / gpt-4.1-mini)
LLM_MODEL=
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (OpenRouter, local server...)
OPENAI_BASE_URL=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ── Agent ────────────────────────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=20
TOOL_TIMEOUT=60

# ── Web search ───────────────────────────────────────────────────────────────
# duckduckgo (free, no key) | brave | serper (Google results)
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=6
SEARCH_REGION=fr-fr

# ── Voice (LiveKit, see README) ──────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STT_API_KEY=
TTS_API_KEY=

# ── API server / client ──────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated bearer tokens accepted by the API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
RATE_LIMIT_PER_MINUTE=30
SERVER_URL=http://127.0.0.1:8000

# ── Logs ─────────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
TRACE_ENABLED=true

# ── Browser (Playwright) — every setting has a safe default ──────────────────
# NEC_BROWSER_ENABLED=true
# NEC_BROWSER_HEADLESS=true
# NEC_BROWSER_CHANNEL=msedge
# NEC_BROWSER_ALLOWED_HOSTS=
# NEC_BROWSER_BLOCKED_HOSTS=
